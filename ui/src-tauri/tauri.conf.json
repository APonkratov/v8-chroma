{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "v8-chroma",
  "version": "0.4.0",
  "identifier": "io.github.aponkratov.v8chroma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "v8-chroma",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#101214",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
