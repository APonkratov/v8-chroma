{
  "format_version": 1,
  "id": "noctis-minimus",
  "name": "Noctis Minimus",
  "colors": {
    "editor.background": "#1B2932",
    "text": "#C5CDD3",
    "panel": "#101213",
    "border": "#496D83",
    "selection.background": "#2A404D",
    "selection.text": "#EBF7FF",
    "line": "#1D3443",
    "comment": "#5E7887",
    "keyword": "#C88DA2",
    "string": "#72C09F",
    "number": "#8E87C5",
    "directive": "#5998C0",
    "accent": "#5998C0",
    "error": "#B96346",
    "warning": "#C09159",
    "disabled": "#6496B4",
    "hover": "#00558A"
  },
  "render": {
    "glyph.background": "editor.background",
    "glyph.foreground": "text",
    "glyph.selection.background": "selection.background",
    "glyph.selection.foreground": "selection.text",
    "raster.background": "panel",
    "raster.foreground": "text",
    "window.caption": "panel",
    "window.text": "text",
    "window.border": "border",
    "window.dark": true
  },
  "syntax": {
    "function": "#C6BAF4",
    "builtin": "#80CBC4",
    "parameter": "#E6B99D",
    "variable": "#E9C66A",
    "type": "#91CFE6",
    "query-keyword": "#78B3FF",
    "query-function": "#C6BAF4"
  }
}
