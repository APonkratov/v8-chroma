{
  "format_version": 1,
  "id": "darcula",
  "name": "Darcula",
  "colors": {
    "editor.background": "#2B2B2B",
    "text": "#A9B7C6",
    "panel": "#3C3F41",
    "border": "#555555",
    "selection.background": "#214283",
    "selection.text": "#FFFFFF",
    "line": "#323232",
    "comment": "#808080",
    "keyword": "#CC7832",
    "string": "#6A8759",
    "number": "#6897BB",
    "directive": "#BBB529",
    "accent": "#589DF6",
    "error": "#FF6B68",
    "warning": "#FFC66D",
    "disabled": "#777777",
    "hover": "#44484B"
  },
  "render": {
    "glyph.background": "editor.background",
    "glyph.foreground": "text",
    "glyph.selection.background": "selection.background",
    "glyph.selection.foreground": "selection.text",
    "raster.background": "panel",
    "raster.foreground": "text",
    "window.caption": "panel",
    "window.text": "text",
    "window.border": "border",
    "window.dark": true
  }
}
